VITE_APP_NAME=EduNexus
VITE_API_TIMEOUT=30000

# Local backend (npm run dev) — defaults to http://127.0.0.1:8000 if omitted
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Production / Railway — set in .env.production (or host env vars) for live builds:
VITE_API_BASE_URL=https://edunexusbackend-staging.up.railway.app
# Railway staging (npm run dev against staging API):
# VITE_API_BASE_URL=https://edunexusbackend-staging.up.railway.app

# Railway production — set in .env.production for live builds:
# VITE_API_BASE_URL=https://edunexusbackend-production.up.railway.app
