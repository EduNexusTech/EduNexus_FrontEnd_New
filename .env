VITE_APP_NAME=EduNexus
# Local backend (used when running npm run dev)
VITE_API_BASE_URL=http://127.0.0.1:8000
; VITE_API_BASE_URL=https://edunexusbackend-production.up.railway.app
VITE_API_TIMEOUT=30000

# EduNexus Post — frontend-only mail (no backend required)
VITE_NEXUS_MAIL_MODE=frontend
VITE_NEXUS_MAIL_FROM=sharanreddy26372@gmail.com
VITE_NEXUS_MAIL_FROM_NAME=EduNexus Post

# Optional: EmailJS for real delivery from the browser (https://www.emailjs.com)
# Connect Gmail as Email Service, create a template with: to_email, from_email, from_name, subject, message, reply_to
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# If EmailJS is not set, opens your default mail app (Gmail/Outlook) with the message pre-filled
VITE_NEXUS_MAIL_USE_MAILTO=true

# Optional: Nexus AI — live GPT responses (https://platform.openai.com/api-keys)
# VITE_AI_API_KEY=
# VITE_AI_API_BASE=https://api.openai.com/v1
# VITE_AI_MODEL=gpt-4o-mini
